{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 46,
  "control-center-margin-right": 10,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 430,
  "control-center-height": 720,
  "notification-window-width": 430,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 160,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "没有通知",
  "script-fail-notify": true,
  "widgets": ["title", "buttons-grid", "volume", "mpris", "dnd", "inhibitors", "notifications"],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "inhibitors": {
      "text": "Idle inhibitors",
      "button-text": "全部清除",
      "clear-all-button": true
    },
    "title": {
      "text": "通知",
      "clear-all-button": true,
      "button-text": "全部清除"
    },
    "dnd": {
      "text": "勿扰模式"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then nmcli radio wifi on; else nmcli radio wifi off; fi'",
          "update-command": "sh -c 'if [ \"$(nmcli -t radio wifi 2>/dev/null)\" = enabled ]; then echo true; else echo false; fi'"
        },
        {
          "label": "静音",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 || wpctl set-mute @DEFAULT_AUDIO_SINK@ 0'",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q \"\\[MUTED\\]\" && echo true || echo false'"
        },
        {
          "label": "蓝牙",
          "type": "toggle",
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then bluetoothctl power on; else bluetoothctl power off; fi'",
          "update-command": "sh -c 'if bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\"; then echo true; else echo false; fi'"
        },
        {
          "label": "声音设置",
          "command": "pavucontrol"
        }
      ]
    },
    "volume": {
      "label": "音量",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "没有活动的应用音频",
      "expand-button-label": "展开应用音量",
      "collapse-button-label": "收起应用音量",
      "animation-type": "slide_down",
      "animation-duration": 160
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false
    }
  }
}
