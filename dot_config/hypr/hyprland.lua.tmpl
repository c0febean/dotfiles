-- Hyprland v1 for this machine (Hyprland 0.56+ Lua configuration).
-- KDE Plasma and SDDM remain installed as the fallback desktop.

local home = os.getenv("HOME") or ""
local terminal = "kitty"
local fileManager = "thunar"
local launcher = home .. "/.local/bin/rofi-launcher"
local wallpaper = "/usr/share/wallpapers/Next/contents/images_dark/5120x2880.png"

----------------
-- Monitors
----------------

-- Keep the geometry already used by KDE. Transform 1 is 90 degrees clockwise.
local secondaryMonitor = {
    output = "DP-3",
    mode = "2560x1440@144",
    position = "0x0",
    scale = 1,
    transform = 1,
    vrr = 0,
    reserved = 0,
}
hl.monitor(secondaryMonitor)

local secondaryColumnWidth = 0.94

hl.monitor({
    output = "DP-2",
    mode = "2560x1440@260",
    position = "1440x451",
    scale = 1,
    transform = 0,
    vrr = 0,
})

-- Safe fallback for a temporary/renamed output without changing the two rules above.
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto",
})

----------------
-- Environment
----------------

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XCURSOR_THEME", "breeze_cursors")
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("XMODIFIERS", "@im=fcitx")
hl.env("HYPRSHOT_DIR", home .. "/media/screenshots")

----------------
-- Input
----------------

hl.config({
    input = {
        kb_layout = "us",
        -- Mouse focus follows the pointer without moving the scrolling view.
        follow_mouse = 1,
        sensitivity = 0,
        numlock_by_default = true,
        touchpad = {
            natural_scroll = false,
            tap_to_click = true,
        },
    },
    cursor = {
        default_monitor = "DP-2",
        sync_gsettings_theme = true,
    },
    binds = {
        window_direction_monitor_fallback = true,
    },
})

----------------
-- Layout and appearance
----------------

hl.config({
    general = {
        layout = "scrolling",
        gaps_in = 3,
        gaps_out = 6,
        border_size = 1,
        resize_on_border = true,
        allow_tearing = false,
        col = {
            active_border = { colors = { "rgba(565f89dd)" }, angle = 45 },
            inactive_border = "rgba(41486866)",
        },
    },
    scrolling = {
        -- Keep the focused column large while reducing each side preview to
        -- roughly half of the previous width.
        column_width = 0.90,
        -- Native fit handles edges. scrolling-view.lua explicitly centers
        -- interior columns after Hyprland finishes processing an event.
        focus_fit_method = 1,
        -- Follow keyboard/click focus, but ignore soft mouse focus changes.
        -- The helper applies the same distinction when centering columns.
        follow_focus = false,
        fullscreen_on_one_column = true,
        wrap_focus = true,
    },
    decoration = {
        rounding = 8,
        rounding_power = 2,
        -- Keep the content readable while allowing the compositor to show
        -- the Tokyo Night glass layer behind normal windows.
        active_opacity = 0.95,
        inactive_opacity = 0.85,
        fullscreen_opacity = 1.0,
        shadow = {
            enabled = true,
            range = 10,
            render_power = 3,
            color = "rgba(00000066)",
        },
        blur = {
            enabled = true,
            size = 5,
            passes = 2,
            new_optimizations = true,
            ignore_opacity = false,
            xray = false,
            noise = 0.012,
            contrast = 1.05,
            brightness = 0.98,
            vibrancy = 0.12,
            vibrancy_darkness = 0.0,
            special = true,
            popups = true,
        },
    },
    animations = {
        enabled = true,
    },
    misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        force_default_wallpaper = 0,
        vrr = 0,
        mouse_move_focuses_monitor = true,
    },
})

hl.curve("v1Ease", { type = "bezier", points = { { 0.2, 0.8 }, { 0.2, 1.0 } } })
hl.animation({ leaf = "windows", enabled = true, speed = 4.5, bezier = "v1Ease" })
hl.animation({ leaf = "fade", enabled = true, speed = 4.0, bezier = "v1Ease" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 4.0, bezier = "v1Ease", style = "fade" })

----------------
-- Workspaces
----------------

for i = 1, 3 do
    hl.workspace_rule({
        workspace = tostring(i),
        monitor = "DP-2",
        persistent = true,
        default = i == 1,
        layout = "scrolling",
    })
end

for i = 4, 6 do
    hl.workspace_rule({
        workspace = tostring(i),
        monitor = "DP-3",
        persistent = true,
        default = i == 6,
        layout = "scrolling",
    })
end

dofile(home .. "/.config/hypr/scrolling-view.lua")(hl)
local secondary = dofile(home .. "/.config/hypr/secondary-layout.lua")(hl, {
    monitor = secondaryMonitor,
    top_fraction = 0.30,
    column_width = secondaryColumnWidth,
    gap = 6,
})

----------------
-- Key bindings
----------------

local super = "SUPER"

-- Everyday actions.
hl.bind(super .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(super .. " + D", hl.dsp.exec_cmd(launcher))
hl.bind(super .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(super .. " + Q", hl.dsp.window.close())
hl.bind(super .. " + F", secondary.unfixed(hl.dsp.window.fullscreen({ action = "toggle" })))
hl.bind(super .. " + SPACE", secondary.unfixed(hl.dsp.window.float({ action = "toggle" })))
-- Optional override alongside automatic arrivals/drop: pin, replace, or unpin on DP-3.
hl.bind(super .. " + P", secondary.toggle_pin)
-- Clipboard history: use the same Rofi stack as the main launcher.
-- Keep the current clipboard when the picker is cancelled or returns empty.
hl.bind(super .. " + V", hl.dsp.exec_cmd("choice=$(cliphist list | rofi -dmenu -i -config " .. home .. "/.config/rofi/config.rasi -p Clipboard) && [ -n \"$choice\" ] && printf '%s\\n' \"$choice\" | cliphist decode | wl-copy"))
hl.bind(super .. " + N", hl.dsp.exec_cmd("swaync-client -t -sw"))
hl.bind(super .. " + SHIFT + E", hl.dsp.exit())

-- Screenshots are saved under Pictures/Screenshots and copied to the clipboard.
hl.bind("ALT + 1", hl.dsp.exec_cmd("hyprshot -m region"))
-- hl.bind("SHIFT + PRINT", hl.dsp.exec_cmd("hyprshot -m output"))
-- hl.bind(super .. " + PRINT", hl.dsp.exec_cmd("hyprshot -m window"))

local directions = {
    H = "left",
    J = "down",
    K = "up",
    L = "right",
}

for key, direction in pairs(directions) do
    hl.bind(super .. " + " .. key, function() secondary.focus(direction) end)
    hl.bind(super .. " + SHIFT + " .. key, function() secondary.move(direction) end)
end

for i = 1, 6 do
    hl.bind(super .. " + " .. i, hl.dsp.focus({ workspace = i }))
    hl.bind(super .. " + SHIFT + " .. i, secondary.unfixed(hl.dsp.window.move({ workspace = i })))
end

-- Mouse movement remains first-class: drag with Super + left button, resize with right.
hl.bind(super .. " + mouse:272", secondary.unfixed(hl.dsp.window.drag()), { mouse = true })
hl.bind(super .. " + mouse:273", secondary.unfixed(hl.dsp.window.resize()), { mouse = true })

-- PipeWire controls; these do not replace the existing audio stack.
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"), { locked = true, repeating = true })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { locked = true })

----------------
-- Autostart
----------------

hl.on("hyprland.start", function()
    -- Make the session identity visible to D-Bus/systemd, then ensure a Portal
    -- left over briefly from Plasma is restarted against Hyprland's backend.
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE && systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service")

    hl.exec_cmd("waybar")
    hl.exec_cmd("pidof nm-applet >/dev/null || nm-applet --indicator")
    -- hl.exec_cmd("hyprpaper")
    hl.exec_cmd("hypridle")
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
    hl.exec_cmd("mpvpaper -o 'loop no-audio' -f DP-2 " .. home .. "/media/wallpaper/main.mp4")
    hl.exec_cmd("mpvpaper -o 'loop no-audio' -f DP-3 " .. home .. "/media/wallpaper/secondary.mp4")

    -- The user's Fcitx desktop entry is intentionally hidden for KDE/KWin,
    -- so Hyprland starts it explicitly.
    hl.exec_cmd("pidof fcitx5 >/dev/null || fcitx5 -d")
    hl.exec_cmd("pidof polkit-gnome-authentication-agent-1 >/dev/null || /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1")
end)

----------------
-- Conservative window rules
----------------

-- Tiled windows receive a maximized state to suppress client-side titlebar
-- decorations. Some clients echo that state back as a real maximize request;
-- ignore those requests so scrolling columns remain navigable.
hl.window_rule({
    name = "suppress-maximize-events",
    match = { class = ".*" },
    suppress_event = "maximize",
})

hl.window_rule({
    name = "picture-in-picture",
    match = { title = "^(Picture-in-Picture|Picture in picture)$" },
    float = true,
})

hl.window_rule({
    name = "common-file-dialogs",
    match = { title = "^(Open File|Save File|Choose Files|Select a File).*" },
    float = true,
})

-- App-specific rules belong here. Match the narrowest class/title possible so
-- ordinary Thunar or browser windows keep the scrolling layout.
hl.window_rule({
    name = "thunar-rename-dialog",
    match = {
        class = "^Thunar$",
        title = "^(Rename|重命名).*",
    },
    float = true,
    center = true,
})

hl.window_rule({
    name = "fix-xwayland-drag-windows",
    match = {
        class = "^$",
        title = "^$",
        xwayland = true,
        float = true,
        fullscreen = false,
        pin = false,
    },
    no_focus = true,
})
